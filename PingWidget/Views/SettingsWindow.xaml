<Window x:Class="PingWidget.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PingWidget Settings" Height="500" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#161616" Foreground="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- General Settings -->
            <RowDefinition Height="*"/>
            <!-- Servers -->
            <RowDefinition Height="Auto"/>
            <!-- Save Button -->
        </Grid.RowDefinitions>

        <!-- General Settings Panel -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Global Settings" FontWeight="Bold" FontSize="14" Foreground="#FFCC00" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Widget Opacity:" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Minimum="20" Maximum="100" Value="{Binding TransparencyPercentage}" TickFrequency="1" IsSnapToTickEnabled="True"/>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Ping Interval (sec):" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding PingIntervalSeconds}" Padding="4" Background="#222" Foreground="White" BorderBrush="#444"/>
            </Grid>

            <CheckBox Content="Always On Top" IsChecked="{Binding AlwaysOnTop}" Foreground="White" Margin="0,4"/>
            <CheckBox Content="Start With Windows" IsChecked="{Binding StartWithWindows}" Foreground="White" Margin="0,4"/>
            <CheckBox Content="Use Default Alarm Sound" IsChecked="{Binding UseDefaultSound}" Foreground="White" Margin="0,4"/>
        </StackPanel>

        <!-- Servers Management Panel -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Monitored Servers" FontWeight="Bold" FontSize="14" Foreground="#FFCC00" Margin="0,0,0,8"/>

            <!-- Server DataGrid (Sorting is now completely disabled so the visual array ALWAYS matches the code) -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" 
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" SelectionMode="Single"
                      Background="#1E1E1E" RowBackground="#2A2A2A" AlternatingRowBackground="#222222" Foreground="White"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#444" BorderThickness="1" BorderBrush="#444"
                      HeadersVisibility="Column">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#333"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="6"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled}"/>
                    <DataGridTextColumn Header="Hostname / IP" Binding="{Binding Hostname}" Width="*"/>
                    <DataGridTextColumn Header="Alarm Threshold (ms)" Binding="{Binding LatencyThresholdMs}" Width="140"/>
                    <DataGridCheckBoxColumn Header="Alarm Audio" Binding="{Binding AlarmEnabled}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Reorder and Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="⬆ Up" Command="{Binding MoveUpCommand}" Width="60" Margin="4,0" Padding="0,4" Background="#333" Foreground="White" BorderThickness="1" BorderBrush="#555"/>
                <Button Content="⬇ Down" Command="{Binding MoveDownCommand}" Width="60" Margin="4,0" Padding="0,4" Background="#333" Foreground="White" BorderThickness="1" BorderBrush="#555"/>
                <TextBlock Text="|" Foreground="#444" Margin="4,0" VerticalAlignment="Center"/>
                <Button Content="➕ Add" Command="{Binding AddServerCommand}" Width="70" Margin="4,0" Padding="0,4" Background="#28a745" Foreground="White" BorderThickness="0"/>
                <Button Content="❌ Remove" Command="{Binding RemoveServerCommand}" Width="75" Margin="4,0" Padding="0,4" Background="#dc3545" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>

        <!-- Save Button -->
        <Button Grid.Row="2" Content="Save &amp; Close" Command="{Binding SaveCommand}" Height="34" Margin="0,16,0,0" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
    </Grid>
</Window>