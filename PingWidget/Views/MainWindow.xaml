<Window x:Class="PingWidget.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PingWidget.Views"
        Title="PingWidget" MinWidth="240" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="{Binding AlwaysOnTop}" ResizeMode="NoResize"
        Opacity="{Binding Transparency}"
        Icon="pack://application:,,,/ping2.ico"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#161616" CornerRadius="6" BorderBrush="#2A2A2A" BorderThickness="1" Padding="6">
        <Grid>
            <!-- No Servers Configured State -->
            <Border Background="#222222" CornerRadius="4" Padding="12" Visibility="{Binding IsNoServersVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Background="Transparent">
                    <TextBlock Text="No servers configured" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                    <TextBlock Text="Right-click anywhere" Foreground="#AAAAAA" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <StackPanel.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Minimize to Tray" Click="Minimize_Click"/>
                            <MenuItem Header="Settings" Click="Settings_Click"/>
                            <Separator/>
                            <MenuItem Header="Quit" Click="Exit_Click"/>
                        </ContextMenu>
                    </StackPanel.ContextMenu>
                </StackPanel>
            </Border>

            <!-- Server List -->
            <ItemsControl ItemsSource="{Binding Servers}" Visibility="{Binding IsNoServersVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <!-- The Tag="{Binding}" ensures the Mute/CMD commands NEVER lose connection -->
                        <views:ServerBarView Tag="{Binding}">
                            <views:ServerBarView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Minimize to Tray" Click="Minimize_Click"/>
                                    <MenuItem Header="Settings" Click="Settings_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Mute Alarm">
                                        <MenuItem Header="1 minute" Command="{Binding PlacementTarget.Tag.MuteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="1"/>
                                        <MenuItem Header="10 minutes" Command="{Binding PlacementTarget.Tag.MuteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="10"/>
                                        <MenuItem Header="30 minutes" Command="{Binding PlacementTarget.Tag.MuteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="30"/>
                                        <MenuItem Header="1 hour" Command="{Binding PlacementTarget.Tag.MuteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="60"/>
                                        <MenuItem Header="3 hours" Command="{Binding PlacementTarget.Tag.MuteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="180"/>
                                        <MenuItem Header="5 hours" Command="{Binding PlacementTarget.Tag.MuteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="300"/>
                                        <MenuItem Header="24 hours" Command="{Binding PlacementTarget.Tag.MuteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="1440"/>
                                        <Separator/>
                                        <MenuItem Header="Always" Command="{Binding PlacementTarget.Tag.MuteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="forever"/>
                                    </MenuItem>
                                    <MenuItem Header="Unmute" Command="{Binding PlacementTarget.Tag.UnmuteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="CMD" Command="{Binding PlacementTarget.Tag.OpenCmdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="Quit" Click="Exit_Click"/>
                                </ContextMenu>
                            </views:ServerBarView.ContextMenu>
                        </views:ServerBarView>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>